# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string

# ─── Cloudinary (Image Uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Leave blank locally to use 5000.
PORT=5000

# ─── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Railway
NODE_ENV=production

# ─── CORS ──────────────────────────────────────────────────────────────────────
# The public URL of your deployed Railway app (shown in Railway dashboard)
# In production this is the same as the backend URL because Express serves
# the frontend build from the same origin.
FRONTEND_URL=https://your-app-name.up.railway.app
