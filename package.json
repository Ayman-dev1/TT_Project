{
  "name": "tabibi-project",
  "version": "1.0.0",
  "description": "Tabibi Project Monorepo Root",
  "main": "backend/server.js",
  "scripts": {
    "install:backend": "cd backend && npm install --production=false",
    "install:frontend": "cd frontend && npm install --production=false",
    "install:all": "npm run install:backend && npm run install:frontend",
    "build": "cd backend && npm install --production=false && cd ../frontend && npm install --production=false && npm run build",
    "start": "node backend/server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
